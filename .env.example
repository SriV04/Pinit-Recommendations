# Google Places API
GOOGLE_PLACE_API_KEY=""

# Supabase Configuration
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Redis Configuration (for caching)
# Local development: use "localhost" or Docker service name "redis"
# Production: use Cloud Memorystore IP or external Redis URL (e.g., Upstash, Redis Cloud)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_DB="0"
REDIS_PASSWORD=""  # Leave empty if no password
REDIS_SSL="false"  # Set to "true" for Upstash, Redis Cloud, or other TLS-enabled services

# Cache Settings
CACHING_ENABLED="true"
CACHE_LARGE_RADIUS_KM="15.0"
CACHE_UNFILTERED_TTL="3600"  # 60 minutes in seconds

# Warm cache scheduler
WARM_CACHE_ENABLED="true"
WARM_CACHE_INTERVAL_SECONDS="900"
WARM_CACHE_ZONE_SET="london"
WARM_CACHE_START_HOUR="9"
WARM_CACHE_END_HOUR="21"
WARM_CACHE_TIMEZONE="Europe/London"

# Pub/Sub location-add pipeline
PUBSUB_ENABLED="true"
PUBSUB_TOPIC_LOCATION_TASKS="location-tasks"

# Cloudflare R2 photo storage (leave empty to keep using Supabase Storage)
# In production R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY come from Secret Manager (see deploy.sh).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
PHOTO_CDN_BASE_URL=""  # e.g. https://img.example.com
# Keep writing photos to Supabase Storage too until the app cutover is done
PHOTO_DUAL_WRITE_SUPABASE="true"
